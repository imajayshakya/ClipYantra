# ClipYantra Workers Environment Configuration
# Copy this file to .env and fill in the values

# =========================================================================
# Application
# =========================================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
WORKER_NAME=worker@%h

# =========================================================================
# Database (PostgreSQL)
# =========================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipyantra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =========================================================================
# Redis (Celery Broker & Result Backend)
# =========================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Celery Configuration
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_CONCURRENCY=4

# Queue Configuration
CELERY_TASK_ROUTES={'app.tasks.ingestion.*': {'queue': 'ingestion'}, 'app.tasks.transcription.*': {'queue': 'transcription'}, 'app.tasks.analysis.*': {'queue': 'analysis'}, 'app.tasks.rendering.*': {'queue': 'rendering'}}
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_CREATE_MISSING_QUEUES=true

# Beat Schedule (Periodic Tasks)
CELERY_BEAT_SCHEDULE={'cleanup-expired-uploads': {'task': 'app.tasks.ingestion.cleanup_expired_uploads', 'schedule': 3600.0}, 'generate-daily-analytics': {'task': 'app.tasks.analysis.generate_daily_analytics', 'schedule': 86400.0}}

# =========================================================================
# Storage
# =========================================================================
# Local storage paths (use volumes in production)
STORAGE_BASE_PATH=/app/data
UPLOAD_PATH=${STORAGE_BASE_PATH}/uploads
THUMBNAIL_PATH=${STORAGE_BASE_PATH}/thumbnails
PROXY_PATH=${STORAGE_BASE_PATH}/proxies
RENDER_PATH=${STORAGE_BASE_PATH}/renders
EXPORT_PATH=${STORAGE_BASE_PATH}/exports
CLIPS_PATH=${STORAGE_BASE_PATH}/clips
ANALYSIS_PATH=${STORAGE_BASE_PATH}/analysis

# S3 Configuration (optional)
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=clipyantra-media
S3_REGION=us-east-1
S3_PUBLIC_URL=

# GCS Configuration (optional)
GCS_ENABLED=false
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=

# =========================================================================
# Media Processing
# =========================================================================
# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=0  # 0 = auto

# Transcription (Whisper)
WHISPER_MODEL=base  # tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu  # cpu, cuda
WHISPER_COMPUTE_TYPE=int8  # int8, float16, float32
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0.0
WHISPER_LANGUAGE=  # auto-detect if empty
WHISPER_TASK=transcribe  # transcribe, translate

# Diarization (pyannote)
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_AUTH_TOKEN=  # Hugging Face token required

# =========================================================================
# Analysis
# =========================================================================
SCENE_DETECTION_THRESHOLD=30.0
SCENE_DETECTION_MIN_SCENE_LEN=1.0
FACE_DETECTION_ENABLED=true
FACE_DETECTION_MODEL=hog  # hog, cnn
FACE_DETECTION_UPSAMPLE=1
CONTENT_ANALYSIS_ENABLED=true

# =========================================================================
# Rendering
# =========================================================================
DEFAULT_RENDER_PRESET=social_1080p
RENDER_TIMEOUT=7200
RENDER_MAX_CONCURRENT=2

# =========================================================================
# Monitoring
# =========================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Datadog (optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# =========================================================================
# API Integration (Backend)
# =========================================================================
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=  # Internal service key
BACKEND_API_TIMEOUT=30

# =========================================================================
# Feature Flags
# =========================================================================
FEATURE_GPU_ACCELERATION=false
FEATURE_ADVANCED_ANALYSIS=false
FEATURE_AUTO_CLIPS=false
FEATURE_MULTI_LANG_TRANSCRIPTION=false

# =========================================================================
# Security
# =========================================================================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173