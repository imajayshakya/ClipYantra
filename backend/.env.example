# ClipYantra Backend Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Application Settings
# =============================================================================
PROJECT_NAME=ClipYantra
VERSION=0.1.0
DESCRIPTION="ClipYantra Backend API for video processing and publishing"
ENVIRONMENT=development
DEBUG=true

# API Settings
API_V1_STR=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Database Settings (PostgreSQL with asyncpg)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipyantra
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# Redis Settings
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Security Settings
# =============================================================================
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Storage Settings
# =============================================================================
# Options: local, s3, gcs, azure
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# S3 Settings (required if STORAGE_BACKEND=s3)
# S3_BUCKET=clipyantra-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT_URL=  # Optional, for S3-compatible storage

# =============================================================================
# Celery Settings
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# =============================================================================
# Media Processing Settings
# =============================================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_FILE_SIZE_MB=5000
ALLOWED_VIDEO_CODECS=["h264","hevc","vp9","av1"]
ALLOWED_AUDIO_CODECS=["aac","mp3","opus","flac"]
ALLOWED_CONTAINERS=["mp4","mov","webm","mkv"]

# =============================================================================
# Logging Settings
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=./logs/clipyantra.log

# =============================================================================
# Monitoring Settings
# =============================================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
PROMETHEUS_METRICS_ENABLED=true